DJANGO_ENV=local
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

POSTGRES_DB=demiresults
POSTGRES_USER=demiresults
POSTGRES_PASSWORD=demiresults
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

N8N_API_TOKEN=change-me
N8N_WEBHOOK_SECRET=change-me

GOOGLE_CLIENT_ID=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=DemiResults <noreply@demiresults.local>
FRONTEND_PASSWORD_RESET_URL=

SMS_PROVIDER=console
PHONE_AUTH_CODE_TTL_MINUTES=5

PAYMENT_PROVIDER=local
LOCAL_PAYMENT_AUTO_CAPTURE=false

BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=7
LOG_DIR=/app/logs
DJANGO_LOG_LEVEL=INFO
